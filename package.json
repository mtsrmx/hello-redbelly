{
  "name": "redbelly-made-simple",
  "version": "1.0.0",
  "private": true,
  "description": "Redbelly explained in everyday language: an 82-second animated explainer, its captions, sources and verification suite.",
  "type": "module",
  "scripts": {
    "preview": "node tools/serve.mjs 8080",
    "captions": "node tools/captions.mjs",
    "audio": "python3 audio/compose.py",
    "render": "node tools/render.mjs --ar 16x9 && node tools/render.mjs --ar 9x16",
    "render:16x9": "node tools/render.mjs --ar 16x9",
    "render:9x16": "node tools/render.mjs --ar 9x16",
    "stills": "node tools/stills.mjs",
    "docs": "node tools/docs.mjs",
    "verify": "node tools/verify.mjs",
    "check-sources": "node tools/check-sources.mjs",
    "produce": "npm run captions && npm run audio && npm run render && npm run docs && npm run verify -- --write"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
